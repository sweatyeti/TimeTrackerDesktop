<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TimeTrackerDesktop.Controls.PrimaryTrackingButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The primary tracking control (plan Task 4.2). The glyph SHAPE differs between the two kinds, so the
         meaning survives without colour: a triangle is not a square even in greyscale. -->
    <Grid>
        <Button
            x:Name="PlayButton"
            Background="{ThemeResource TrackingPlayBrush}"
            Click="OnClick"
            Style="{StaticResource TrackingIconButtonStyle}">
            <Path
                Data="M 0,0 L 14,8 L 0,16 Z"
                Fill="{ThemeResource TrackingPlayGlyphBrush}" />
        </Button>

        <Button
            x:Name="StopButton"
            Background="{ThemeResource TrackingStopBrush}"
            Click="OnClick"
            Style="{StaticResource TrackingIconButtonStyle}"
            Visibility="Collapsed">
            <Rectangle
                Width="12"
                Height="12"
                Fill="{ThemeResource TrackingStopGlyphBrush}" />
        </Button>
    </Grid>
</UserControl>
