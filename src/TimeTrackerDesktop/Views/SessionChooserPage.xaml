<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TimeTrackerDesktop.Views.SessionChooserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:TimeTrackerDesktop.ViewModels">

    <!-- Plan Task 4.1: a session must be chosen before the widget opens. Start New Session is the primary
         action and needs no name, so it is the accented button; Resume is only available once a row is
         selected, which is what makes the disabled state meaningful rather than decorative.

         No explicit size here, deliberately: the window's size is set through the interop service, and a
         Height on this root made the page taller than its host, which clipped the action row off the bottom
         entirely. Measured - the window reported 460x620 while only the heading rendered. -->
    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Choose a session" />

        <ListView
            x:Name="SessionList"
            Grid.Row="1"
            ItemsSource="{x:Bind ViewModel.Choices}"
            SelectedItem="{x:Bind ViewModel.SelectedChoice, Mode=TwoWay}"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:SessionChoice">
                    <StackPanel Padding="0,6" Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                        <TextBlock
                            Opacity="0.7"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Description}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock
                x:Name="MessageText"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="StartNewButton"
                    Click="OnStartNewSession"
                    Content="Start New Session"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="ResumeButton"
                    Click="OnResume"
                    Content="Resume"
                    IsEnabled="{x:Bind ViewModel.CanResume, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
