<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="TimeTrackerDesktop.Views.WidgetShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:TimeTrackerDesktop.Controls"
    xmlns:viewModels="using:TimeTrackerDesktop.ViewModels">

    <UserControl.Resources>
        <viewModels:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <!-- The compact widget card (plan Task 4.2). Every state difference is expressed as wording or as a
         control's presence, never as colour alone: the state line reads "No task running" when idle, the task
         and description fields disappear, and Stop is disabled rather than merely dimmed.

         The explicit size is load-bearing: WinUI sizes a window from its content's desired size, so this is
         what gives the widget its compact card rather than a default. -->
    <Border
        Width="420"
        Height="260"
        Background="{ThemeResource WidgetCardBrush}"
        BorderBrush="{ThemeResource WidgetCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="10"
        Padding="12">
        <StackPanel Spacing="8">

            <TextBlock
                x:Name="StateText"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.StateLabel, Mode=OneWay}"
                TextWrapping="Wrap" />

            <StackPanel Spacing="0">
                <TextBlock
                    x:Name="StartedText"
                    Style="{StaticResource WidgetMutedTextStyle}"
                    Text="{x:Bind ViewModel.StartedDisplay, Mode=OneWay}" />
                <TextBlock
                    x:Name="ElapsedText"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.ElapsedDisplay, Mode=OneWay}" />
            </StackPanel>

            <TextBox
                x:Name="TaskField"
                Header="Task"
                LostFocus="OnTaskLostFocus"
                Text="{x:Bind ViewModel.TaskText, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsTaskFieldVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <TextBox
                x:Name="DescriptionField"
                Header="Description"
                LostFocus="OnDescriptionLostFocus"
                Text="{x:Bind ViewModel.DescriptionText, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsDescriptionVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:PrimaryTrackingButton x:Name="PlayControl" Click="OnPlay" />
                <controls:PrimaryTrackingButton x:Name="StopControl" Click="OnStop" />

                <Button
                    x:Name="EditTaskButton"
                    Click="OnEditTask"
                    Content="Edit task"
                    Visibility="{x:Bind ViewModel.IsDescriptionVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <TextBlock
                x:Name="MessageText"
                Style="{StaticResource WidgetMutedTextStyle}"
                Text="{x:Bind ViewModel.Message, Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
