<?xml version="1.0" encoding="utf-8"?>
<!--
  Portable v1 publish profile: unpackaged, self-contained win-x64 folder payload.

  Deliberately NOT PublishSingleFile (the plan prefers a folder-in-ZIP that is easy to diagnose and
  avoids first-run self-extraction) and NOT PublishTrimmed (trimming is risky against WinUI's
  reflection-heavy paths and saves little for an app this size).

  Invoked as: dotnet publish src/TimeTrackerDesktop/TimeTrackerDesktop.csproj -c Release -p:PublishProfile=win-x64
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish\</PublishDir>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
